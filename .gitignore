# ─── deps ────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ─── build outputs ───────────────────────────────────────────────────
# desktop: dist/ + out/ + release/ + dist_electron/
# extension: out/ + webview/dist/ + *.vsix
# 주의: 데스크탑 최상위 build/ 는 electron-builder 빌드 리소스(아이콘, entitlements)이므로
# apps/desktop/build/ 는 무시 안 함. 그 외 build/ 는 무시.
dist/
out/
release/
build/
!apps/desktop/build/
dist_electron/
webview/dist/
*.vsix
*.dmg
*.zip
*.exe
*.AppImage
*.deb
*.rpm
*.tsbuildinfo
.vite/
.eslintcache

# ─── env / secrets ───────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.*
!.env.example

# ─── OS / iCloud ─────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.icloud

# ─── editors / IDE ───────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo

# ─── logs ────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── coverage / cache ────────────────────────────────────────────────
coverage/
.nyc_output/
.cache/
.tmp/

# ─── CLI cwd hook 파일 (사용자 cwd 영역, repo와 분리) ─────────────────
# dev 검증을 repo root에서 진행하면 생길 수 있음. 마커 블록 merge로만 관리.
.codex/
.gemini/
.agents/
.antigravitycli/

# ─── machine-local config ────────────────────────────────────────────
.claude/
.deepsource-local/
dev-app-update.yml
.agentbridge/
workspace_data/
subspace/
tmp_asar/

# ─── 내부 개발 문서 (외부 공개 X, 로컬 보존) ──────────────────────────
