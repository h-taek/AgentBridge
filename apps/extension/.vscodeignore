.vscode/**
src/**
probe/**
docs/**
webview/src/**

# node_modules는 전부 제외 — pnpm 심링크라 vsce가 못 다루고, `vsce package --no-dependencies`로
# 싼다. 런타임에 필요한 것(node-pty 네이티브, xterm webview 에셋)은 esbuild.mjs가 빌드 시
# out/ 하위로 vendoring하므로 아래 `!out/**`로 함께 포함된다.
#   - node-pty  → out/node_modules/node-pty (require("node-pty") 해석 위치)
#   - xterm     → out/vendor/@xterm/...      (chatPanel asWebviewUri 로드 위치)
node_modules/**

**/*.pdb
**/*.ts
!out/**
!resources/**
!media/**
.gitignore
tsconfig.json
tsconfig.test.json
.mocharc.json
.depcheckrc.json
eslint.config.mjs
esbuild.mjs
knip.json
package-lock.json
*.vsix
*.map
test/**

# Workspace-local hook fixtures — must NOT ship in the VSIX. These are install targets
# that the extension writes into the user's workspace at runtime.
.agents/**
.codex/**
.antigravitycli/**

# iCloud / Finder duplicates ("foo 2.json", "foo 2.svg", "foo 2.js.map", etc.)
**/* 2.*
**/* 2

# macOS metadata
**/.DS_Store
