.vscode/**
src/**
probe/**
docs/**
webview/src/**

# Exclude all of node_modules, then whitelist only what node-pty needs at runtime
# (lib + darwin prebuilds). Avoid `!node_modules/node-pty/**` because it re-includes
# every win32/linux prebuild and *.pdb file, blowing up the VSIX to ~60 MB.
node_modules/**
!node_modules/node-pty/package.json
!node_modules/node-pty/lib/**
!node_modules/node-pty/prebuilds/darwin-arm64/**
!node_modules/node-pty/prebuilds/darwin-x64/**

# xterm webview assets — loaded by chatPanel via asWebviewUri from node_modules
!node_modules/@xterm/xterm/package.json
!node_modules/@xterm/xterm/css/**
!node_modules/@xterm/xterm/lib/**
!node_modules/@xterm/addon-fit/package.json
!node_modules/@xterm/addon-fit/lib/**
!node_modules/@xterm/addon-webgl/package.json
!node_modules/@xterm/addon-webgl/lib/**
!node_modules/@xterm/addon-unicode11/package.json
!node_modules/@xterm/addon-unicode11/lib/**

# Trim source maps from shipped xterm bundles to keep VSIX small
node_modules/@xterm/**/*.map

**/*.pdb
**/*.ts
!out/**
!resources/**
!media/**
.gitignore
tsconfig.json
tsconfig.test.json
.mocharc.json
.depcheckrc.json
eslint.config.mjs
knip.json
package-lock.json
*.vsix
*.map
test/**

# Workspace-local hook fixtures — must NOT ship in the VSIX. These are install targets
# that the extension writes into the user's workspace at runtime.
.agents/**
.codex/**
.antigravitycli/**

# iCloud / Finder duplicates ("foo 2.json", "foo 2.svg", "foo 2.js.map", etc.)
**/* 2.*
**/* 2

# macOS metadata
**/.DS_Store
