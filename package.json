{
  "name": "agentbridge-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "AgentBridge monorepo — desktop app + VS Code extension + shared core",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
